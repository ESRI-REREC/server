# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — credentials must never be committed.

# Portal base URL (no trailing slash). generateToken lives at
# ${ARCGIS_PORTAL_URL}/sharing/rest/generateToken
ARCGIS_PORTAL_URL=https://development.esriea.com/portal

# --- Feature layer URLs -------------------------------------------------------
# One per layer, each named ARCGIS_<NAME>_LAYER_URL. Add future layers here
# following the same convention.
#
# Facilities layer. /addFeatures is posted to ${ARCGIS_FACILITIES_LAYER_URL}/addFeatures
ARCGIS_FACILITIES_LAYER_URL=https://development.esriea.com/server/rest/services/Hosted/Facilities/FeatureServer/0
# Projects table. Used by /api/survey-assignments to set surveyed_by.
ARCGIS_PROJECTS_LAYER_URL=https://development.esriea.com/server/rest/services/Hosted/Projects/FeatureServer/0

# Credentials. Ideally a dedicated account allowed to edit only these layers.
ARCGIS_USERNAME=your_username
ARCGIS_PASSWORD=your_password

# Origin the referer-based token is bound to. Set to the app's public origin.
# For local dev this is the Next.js dev server origin.
ARCGIS_REFERER=http://localhost:3000

# Token lifetime in minutes. The server re-mints automatically before expiry.
ARCGIS_TOKEN_EXPIRATION_MINUTES=60

# Which browser origins may call /api/token and /api/addFeatures (CORS).
# Comma-separated exact origins, or "*" to allow any (fine for a POC).
# e.g. ALLOWED_ORIGINS=https://facility-app.example.com,http://localhost:8000
ALLOWED_ORIGINS=*
